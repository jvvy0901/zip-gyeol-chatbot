# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 깃에 올리지 마세요.

# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=

# 집결 웹사이트 주소. 답변 속 /listings/1 같은 링크가 이 주소로 열려요.
WEBSITE_URL=http://localhost:5000

# 답변 모델과 추론 강도 (none | low | medium | high)
CHAT_MODEL=gpt-6-luna
CHAT_REASONING=medium

# IP당 1분에 보낼 수 있는 질문 수
RATE_LIMIT_PER_MIN=15
